# Kopieer naar .env.local voor lokaal draaien. Op Vercel zet je deze bij Settings → Environment Variables.

# Planner (/app)
TAKEN_PASSWORD=            # wachtwoord voor de app; lokaal is het "taken" als je dit leeg laat
TAKEN_SECRET=              # lange willekeurige tekst (bijv. `openssl rand -base64 32`): ondertekent sessies en versleutelt het Google-token
GOOGLE_CLIENT_ID=          # Google OAuth-client (zie README, "Google-koppeling instellen")
GOOGLE_CLIENT_SECRET=
# TAKEN_DATA_FILE=         # pad voor de bestandsopslag als er geen Redis is (standaard .taken-data.json)

# Opslag (Upstash Redis via de Vercel Marketplace; gedeeld door Planner en Ranking the Stars)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Ranking the Stars (/rankingthestars)
RTS_TEAM_CODE=             # lokaal "sterren"
RTS_ADMIN_PIN=             # lokaal "1234"
